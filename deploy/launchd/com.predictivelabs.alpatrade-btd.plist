<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac backup instance of the live Mag-7 BTD runner (docs/strategy_methodology.md).
  launchd only STARTS and KEEPS ALIVE the long-running in-memory event scheduler
  (KeepAlive + RunAtLoad); there is no StartCalendarInterval — all event timing (09:31 open,
  15:45-15:55 entries, ~15:58 close, 3-min lease heartbeats, holidays/early closes from the
  Alpaca calendar) lives in scripts/live_btd_scheduler.py. Params: alpatrade.strategy_configs.
  Install:  sed "s#/Users/juliankaljuvee#$HOME#g" deploy/launchd/com.predictivelabs.alpatrade-btd.plist \
              > ~/Library/LaunchAgents/com.predictivelabs.alpatrade-btd.plist
            launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.predictivelabs.alpatrade-btd.plist
  Reload config: launchctl kill HUP gui/$(id -u)/com.predictivelabs.alpatrade-btd
  Off:      launchctl bootout gui/$(id -u)/com.predictivelabs.alpatrade-btd
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.predictivelabs.alpatrade-btd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/juliankaljuvee/dev/plai/alpatrade/.venv/bin/python</string>
        <string>/Users/juliankaljuvee/dev/plai/alpatrade/scripts/live_btd_scheduler.py</string>
        <string>--live</string>
    </array>
    <key>WorkingDirectory</key><string>/Users/juliankaljuvee/dev/plai/alpatrade</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BTD_ROLE</key><string>backup</string>
        <key>BTD_INSTANCE</key><string>mac</string>
        <key>PYTHONUNBUFFERED</key><string>1</string>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>ThrottleInterval</key><integer>15</integer>
    <key>ExitTimeOut</key><integer>300</integer>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>/Users/juliankaljuvee/.alpatrade-live/logs/launchd.out.log</string>
    <key>StandardErrorPath</key><string>/Users/juliankaljuvee/.alpatrade-live/logs/launchd.err.log</string>
</dict>
</plist>
