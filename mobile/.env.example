# AlpaTrade Mobile - Environment Variables
# Copy to .env and fill in values (do NOT commit .env)

# API (REST + SSE chat)
API_BASE_URL=https://api.alpatrade.chat

# Realtime voice WebSocket (x.ai proxy)
VOICE_WS_URL=wss://alpatrade.chat/ws/voice

# Firebase (finespresso project — App Distribution)
# Repo secrets FIREBASE_APP_ID + FIREBASE_SERVICE_ACCOUNT are already set in GitHub Actions.
FIREBASE_PROJECT_ID=finespresso
FIREBASE_APP_ID=1:76656799510:android:ac67bd0c68d4d3e53eea37

# Android Signing (for release builds)
# KEYSTORE_PATH=android/app/upload-keystore.jks
# KEY_ALIAS=upload
# KEY_PASSWORD=
# STORE_PASSWORD=
