FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Assisted "connect alpaca" chat flow (engine/alpaca_connect.py) needs headless Chromium.
# Opt-in at build time so the default image stays small: build with
# --build-arg ALPACA_CONNECT_BROWSER=1 and set ALPACA_CONNECT_ENABLED=1 at runtime.
ARG ALPACA_CONNECT_BROWSER=0
RUN if [ "$ALPACA_CONNECT_BROWSER" = "1" ]; then \
      pip install --no-cache-dir "playwright>=1.58" && python -m playwright install --with-deps chromium; \
    fi

COPY . .

ENV AGUI_RELOAD=false
# Serve the merged single FastHTML app (landing + auth + chat + guide + voice).
ENV ASSETHERO_WEB_PORT=5003
# The same image also powers the separate Compose autonomy service. The web
# process does not start worker or scheduler threads.
ENV AUTONOMY_ENABLED=true

EXPOSE 5003

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:5003/healthz', timeout=5)"

CMD ["python", "main.py"]
